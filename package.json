{
  "name": "dsh-auth-gateway",
  "version": "1.0.0",
  "description": "Zero-credential gateway for DeepSeek Harness web GUI: a standalone reverse proxy that obtains a valid DSH session inside the host process and injects it into every HTTP/WebSocket request, so browsers need no token or cookie. 免认证访问网关（DSH 插件）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "gateway",
    "reverse-proxy",
    "auth",
    "session-cookie",
    "免认证"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  },
  "author": "kssku",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kssku/dsh-auth-gateway.git"
  },
  "types": "lib/index.d.ts",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-manifest.mjs",
    "check": "npm run typecheck && npm run build && npm run validate",
    "pack:check": "npm pack --dry-run --json",
    "prepack": "npm run build"
  }
}
